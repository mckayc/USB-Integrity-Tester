<UserControl x:Class="UsbIntegrityTester.App.Views.UsbConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="560" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                        Width="40" Height="40" Margin="0,0,12,0">
                    <ui:SymbolIcon Symbol="PlugConnected24" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="USB Connections" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Reads the actual negotiated link speed from the USB hub, not just the port's nominal label."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <ui:CardControl Margin="0,0,0,16">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="PlugConnected24"/>
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <TextBlock Text="{Binding SelectedDrive.Model, StringFormat='Selected drive: {0}', FallbackValue='No drive selected'}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </ui:CardControl.Header>
            </ui:CardControl>

            <ui:Button Content="Inspect Port" Command="{Binding InspectPortCommand}"
                       HorizontalAlignment="Left" Margin="0,0,0,16" Appearance="Primary">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="PlugConnected24"/>
                </ui:Button.Icon>
            </ui:Button>

            <TextBlock Text="{Binding NegotiatedLinkSpeedText}" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,16"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20"
                       Text="A USB 3 port with a USB 2 hub or cable somewhere in the path will correctly show as High Speed here, even though the port itself is rated faster. If auto-detection ever looks wrong for your hardware, check the Logs tab for the step-by-step trace (it'll show exactly which lookup failed), and use the override below to set the port speed manually — reports and speed-ceiling comparisons will use whichever you set."/>

            <ui:CardExpander Header="Device details" IsExpanded="True" Margin="0,0,0,16">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Info24"/>
                </ui:CardExpander.Icon>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Vendor / Product ID" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DeviceIdText}" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Transport protocol" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TransportText}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Hub position" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HubHopsText}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </Grid>
            </ui:CardExpander>

            <ui:CardExpander Header="System info" Margin="0,0,0,16">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="DesktopPulse24"/>
                </ui:CardExpander.Icon>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="{Binding SystemInfoText}" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:InfoBar IsOpen="True" IsClosable="False"
                                Severity="{Binding IsElevated, Converter={StaticResource ElevationSeverityConverter}}"
                                Message="{Binding ElevationText}"/>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander Header="Manual override" Margin="0,0,0,16">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Settings24"/>
                </ui:CardExpander.Icon>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Actual port configuration" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox ItemsSource="{Binding AvailableLinkSpeeds}"
                              SelectedItem="{Binding ManualLinkSpeedOverride}"
                              Margin="0,0,0,8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource UsbLinkSpeedDisplayConverter}}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ui:Button Content="Clear override (use auto-detection)" Padding="8,4" HorizontalAlignment="Left"
                               Click="ClearOverride_Click"/>
                </StackPanel>
            </ui:CardExpander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
