<UserControl x:Class="UsbIntegrityTester.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UsbIntegrityTester.App.ViewModels"
             xmlns:controls="clr-namespace:UsbIntegrityTester.App.Controls"
             mc:Ignorable="d" d:DesignWidth="900">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:SpeedComparisonRow}">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap"/>

                <Grid Grid.Column="1" Height="14" VerticalAlignment="Center" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding BarFraction, Converter={StaticResource FractionToStarConverter}}"/>
                        <ColumnDefinition Width="{Binding RemainderFraction, Converter={StaticResource FractionToStarConverter}}"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{Binding BarBrush}" CornerRadius="3"/>
                    <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="3" Margin="2,0,0,0"/>
                </Grid>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding MeasuredText}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DetailText}" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReportTrendCard}">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Width="220" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding AverageText}" FontSize="11" Margin="0,0,10,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding PeakText}" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <controls:Sparkline Points="{Binding Points}" Stroke="{Binding Stroke}" Fill="{Binding Fill}"
                                         Height="56" StrokeThickness="2"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReportStat}">
            <StackPanel Margin="0,0,20,12" MinWidth="160">
                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{Binding Value}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Report" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <ui:Button Content="Export Report as PNG" Click="ExportReportPng_Click" Padding="12,6">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowExportUp24"/>
                </ui:Button.Icon>
            </ui:Button>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border x:Name="ReportCard" Background="{DynamicResource ApplicationBackgroundBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                    <TextBlock Text="{Binding LastReport.DriveLabel, StringFormat='Drive: {0}', FallbackValue='No test run yet'}"
                               FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding LastReport.TimestampUtc, StringFormat='Tested: {0:g} UTC'}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,16"/>

                    <!-- Verdict banner -->
                    <Border CornerRadius="8" Padding="16" Margin="0,0,0,20"
                            Background="{Binding LastReport.Verdict.Verdict, Converter={StaticResource DriveVerdictToBrushConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="32" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"
                                           Symbol="{Binding LastReport.Verdict.Verdict, Converter={StaticResource DriveVerdictToIconConverter}}"/>
                            <StackPanel>
                                <TextBlock Text="{Binding VerdictText}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding VerdictExplanationText}" FontSize="13" Foreground="White"
                                           TextWrapping="Wrap" Opacity="0.9" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Capacity meter -->
                    <TextBlock Text="Capacity" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="{Binding CapacitySummary.HeadlineText}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CapacitySummary.DetailText}" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12"/>

                            <Grid Height="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding CapacitySummary.VerifiedFraction, Converter={StaticResource FractionToStarConverter}}"/>
                                    <ColumnDefinition Width="{Binding CapacitySummary.RemainderFraction, Converter={StaticResource FractionToStarConverter}}"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{Binding CapacitySummary.BarBrush}" CornerRadius="4"/>
                                <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4" Margin="2,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Speed: claimed vs. measured -->
                    <TextBlock Text="Speed: Claimed vs. Measured" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding SpeedComparisonRows}" Margin="0,0,0,20"/>

                    <!-- Burst vs. sustained trend, one card per workload -->
                    <TextBlock Text="Burst vs. Sustained Throughput — reveals a cache cliff if the drive has one" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding TrendCards}" Margin="0,0,0,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Everything else, numerically -->
                    <TextBlock Text="Details" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <WrapPanel Margin="0,0,0,4">
                        <StackPanel Margin="0,0,20,12" MinWidth="160">
                            <TextBlock Text="Serial Number" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding LastReport.SerialNumber}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,20,12" MinWidth="160">
                            <TextBlock Text="Claimed Capacity" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock FontSize="15" FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <Binding Path="LastReport.ClaimedCapacityBytes" StringFormat="{}{0:N1} GB" Converter="{StaticResource BytesToGbConverter}"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ExtraStats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </WrapPanel>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </DockPanel>
</UserControl>
