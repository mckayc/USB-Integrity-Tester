<UserControl x:Class="UsbIntegrityTester.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UsbIntegrityTester.App.ViewModels"
             xmlns:local="clr-namespace:UsbIntegrityTester.App"
             mc:Ignorable="d" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!-- One speed test category's full report: claimed-vs-measured numbers for both
             directions, then a plain-language "how long would this actually take" paragraph.
             Deliberately text and numbers only — no bars, no charts. -->
        <DataTemplate DataType="{x:Type vm:SpeedTestSlotReportRow}">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,2" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <Run Text="{Binding CategoryName, Mode=OneWay}"/>
                        <Run Text=" — " Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <Run Text="{Binding WorkloadDescription, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="Normal"/>
                    </TextBlock>
                    <TextBlock Text="{Binding SizeRangeText, StringFormat='File size tested: {0}'}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="WRITE" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding WriteAvgText}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="✓" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#2ECC71"
                                           Visibility="{Binding WriteMeetsClaim, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="▼" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#E74C3C"
                                           Visibility="{Binding WriteMeetsClaim, Converter={StaticResource InverseBoolToVisibility}}"/>
                            </StackPanel>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="{Binding WritePeakText, Mode=OneWay}"/>
                                <Run Text="{Binding WriteClaimText, Mode=OneWay, StringFormat=' · {0}'}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="READ" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ReadAvgText}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="✓" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#2ECC71"
                                           Visibility="{Binding ReadMeetsClaim, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="▼" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#E74C3C"
                                           Visibility="{Binding ReadMeetsClaim, Converter={StaticResource InverseBoolToVisibility}}"/>
                            </StackPanel>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="{Binding ReadPeakText, Mode=OneWay}"/>
                                <Run Text="{Binding ReadClaimText, Mode=OneWay, StringFormat=' · {0}'}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12,10">
                        <TextBlock Text="{Binding PracticalTimeText}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReportStat}">
            <StackPanel Margin="0,0,20,12" MinWidth="160">
                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{Binding Value}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Report" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <ui:Button Content="Save as Text File" Command="{Binding SaveReportTextCommand}" Padding="12,6" Margin="0,0,8,0">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Save24"/>
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="{Binding CopyReportButtonText}" Command="{Binding CopyReportCommand}" Padding="12,6">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Copy24"/>
                </ui:Button.Icon>
            </ui:Button>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border x:Name="ReportCard" Background="{DynamicResource ApplicationBackgroundBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                    <TextBlock Text="{Binding LastReport.DriveLabel, StringFormat='Drive: {0}', FallbackValue='No test run yet'}"
                               FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding LastReport.TimestampUtc, StringFormat='Tested: {0:g} UTC'}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,16"/>

                    <!-- Verdict banner -->
                    <Border CornerRadius="8" Padding="16" Margin="0,0,0,20"
                            Background="{Binding LastReport.Verdict.Verdict, Converter={StaticResource DriveVerdictToBrushConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="32" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"
                                           Symbol="{Binding LastReport.Verdict.Verdict, Converter={StaticResource DriveVerdictToIconConverter}}"/>
                            <StackPanel>
                                <TextBlock Text="{Binding VerdictText}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding VerdictExplanationText}" FontSize="13" Foreground="White"
                                           TextWrapping="Wrap" Opacity="0.9" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Capacity, in numbers -->
                    <TextBlock Text="Capacity" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="{Binding CapacitySummary.HeadlineText}" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding CapacitySummary.DetailText}" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding CapacitySummary.ScanThoroughnessText}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Speed tests: numbers plus practical transfer-time estimates -->
                    <TextBlock Text="Speed Tests" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding SpeedTestRows}" Margin="0,0,0,8"/>

                    <!-- Everything else, numerically -->
                    <TextBlock Text="Details" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <WrapPanel Margin="0,0,0,4">
                        <StackPanel Margin="0,0,20,12" MinWidth="160">
                            <TextBlock Text="Serial Number" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding LastReport.SerialNumber}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,20,12" MinWidth="160">
                            <TextBlock Text="Claimed Capacity" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                <TextBlock.Text>
                                    <Binding Path="LastReport.ClaimedCapacityBytes" StringFormat="{}{0:N1} GB" Converter="{StaticResource BytesToGbConverter}"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ExtraStats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </WrapPanel>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </DockPanel>
</UserControl>
