<UserControl x:Class="UsbIntegrityTester.App.Views.TestingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UsbIntegrityTester.App.ViewModels"
             xmlns:controls="clr-namespace:UsbIntegrityTester.App.Controls"
             xmlns:views="clr-namespace:UsbIntegrityTester.App.Views"
             mc:Ignorable="d" d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Shared chrome for every Run Test card: highlights with an accent border and a subtle
             background tint while its test is actually running, so the active card is obvious
             even now that all four are the same size. -->
        <Style x:Key="TrackCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="BorderBrush" Value="#00A6FB"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A small pulsing dot next to the title, visible only while this card's test is running
             — a second, harder-to-miss cue alongside the accent border for "this one is live now". -->
        <Style x:Key="LiveDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="#00A6FB"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Name="LiveDotPulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.25" Duration="0:0:0.7"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="LiveDotPulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One direction (Write, or Read/Verify) of a speed track: number + trend line. Used
             twice per speed card, side by side, so write and read never share one line. -->
        <DataTemplate x:Key="SpeedChannelTemplate" DataType="{x:Type vm:TestChannelViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentThroughputText}" FontSize="22" FontWeight="Bold"
                               Foreground="{Binding ThroughputBrush}"/>
                    <TextBlock Text="{Binding ClaimStatusGlyph}" FontSize="14" FontWeight="Bold" Margin="6,0,0,0"
                               VerticalAlignment="Center" Foreground="{Binding ClaimStatusBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,2,0,6">
                    <TextBlock Text="{Binding AverageThroughputText}" FontSize="10"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding PeakThroughputText}" FontSize="10"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <controls:Sparkline Grid.Row="3" Points="{Binding LivePoints}" StrokeThickness="2"
                                     Stroke="{Binding ThroughputBrush}" Fill="{Binding ThroughputFillBrush}"/>
            </Grid>
        </DataTemplate>

        <!-- Large/Small/Huge File cards: overall progress, then Write and Read side by side, each
             with its own number and trend line. Every track uses this same full layout now,
             regardless of whether it's the one currently running — only their order changes. -->
        <DataTemplate x:Key="SpeedCardTemplate" DataType="{x:Type vm:TestTrackViewModel}">
            <Border Style="{StaticResource TrackCardBorderStyle}"
                    Opacity="{Binding IsSelected, Converter={StaticResource BoolToCardOpacityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="120"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Style="{StaticResource LiveDotStyle}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <ProgressBar Grid.Row="1" Height="4" Minimum="0" Maximum="1" Margin="0,0,0,12"
                                 Value="{Binding ProgressFraction, Mode=OneWay}"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl Grid.Column="0" Content="{Binding Primary}" ContentTemplate="{StaticResource SpeedChannelTemplate}"/>
                        <ContentControl Grid.Column="2" Content="{Binding Secondary}" ContentTemplate="{StaticResource SpeedChannelTemplate}"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Capacity Test card: instead of a throughput line, shows how much of the claimed
             capacity has actually been written and verified so far — a fake-capacity drive stalls
             partway across these bars instead of just showing a slow number. -->
        <DataTemplate x:Key="CapacityCardTemplate" DataType="{x:Type vm:TestTrackViewModel}">
            <Border Style="{StaticResource TrackCardBorderStyle}"
                    Opacity="{Binding IsSelected, Converter={StaticResource BoolToCardOpacityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Style="{StaticResource LiveDotStyle}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <ProgressBar Height="4" Minimum="0" Maximum="1" Margin="0,0,0,14"
                                 Value="{Binding ProgressFraction, Mode=OneWay}"/>

                    <!-- Write pass -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Primary.Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Primary.CurrentThroughputText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <Grid Height="12" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Primary.ProgressFraction, Converter={StaticResource FractionToStarConverter}}"/>
                            <ColumnDefinition Width="{Binding Primary.RemainderFraction, Converter={StaticResource FractionToStarConverter}}"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{Binding Primary.ThroughputBrush}" CornerRadius="3"/>
                        <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="3" Margin="2,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding Primary.DetailText}" FontSize="11" Margin="0,0,0,14" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <!-- Verify pass -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Secondary.Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Secondary.CurrentThroughputText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <Grid Height="12" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Secondary.ProgressFraction, Converter={StaticResource FractionToStarConverter}}"/>
                            <ColumnDefinition Width="{Binding Secondary.RemainderFraction, Converter={StaticResource FractionToStarConverter}}"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{Binding Secondary.ThroughputBrush}" CornerRadius="3"/>
                        <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="3" Margin="2,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding Secondary.DetailText}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <TextBlock Text="{Binding FailedBlocksText}" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0"
                               Foreground="#E74C3C" TextWrapping="Wrap"
                               Visibility="{Binding FailedBlocksText, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <views:TestTrackHeroTemplateSelector x:Key="TrackTemplateSelector"
                                              CapacityTemplate="{StaticResource CapacityCardTemplate}"
                                              SpeedTemplate="{StaticResource SpeedCardTemplate}"/>
    </UserControl.Resources>
    <Grid>
        <TabControl Background="Transparent">
            <TabControl.Resources>
                <!-- Bigger, icon-carrying tab headers instead of the default plain-text ones —
                     each tab keeps a consistent identity color across its header icon and its
                     page's own title badge below, so Setup and Run read as visually different
                     places, not just different labels on the same look. -->
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="16,10"/>
                    <Setter Property="FontSize" Value="14"/>
                </Style>
            </TabControl.Resources>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="17" Margin="0,0,8,0"/>
                        <TextBlock Text="Test Setup" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="640" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                                    Width="40" Height="40" Margin="0,0,12,0">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Test Setup" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Choose how the test accesses the drive, then your tests and settings, then run."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <ui:CardExpander Header="Test Mode" IsExpanded="True" Margin="0,0,0,12">
                            <ui:CardExpander.Icon>
                                <ui:SymbolIcon Symbol="Settings24"/>
                            </ui:CardExpander.Icon>
                            <StackPanel Margin="0,8,0,0">
                                <RadioButton GroupName="TestMode" Margin="0,0,0,2"
                                             IsChecked="{Binding TestMode, Converter={StaticResource TestModeFileConverter}}">
                                    <TextBlock Text="File Mode — writes real files, visible live in Explorer" TextWrapping="Wrap"/>
                                </RadioButton>
                                <TextBlock Text="Recommended. Keeps the drive mounted so you can watch test files appear as they're written — great for showing a test in progress."
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,10"/>

                                <RadioButton GroupName="TestMode" Margin="0,0,0,2"
                                             IsChecked="{Binding TestMode, Converter={StaticResource TestModeRawConverter}}">
                                    <TextBlock Text="Raw Mode — direct sector access, most thorough" TextWrapping="Wrap"/>
                                </RadioButton>
                                <TextBlock Text="Dismounts the volume for the whole test — nothing visible in Explorer until it finishes. Always erases all data. Use this if you want the most exhaustive possible check."
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,12"/>

                                <StackPanel Visibility="{Binding TestMode, Converter={StaticResource TestModeToFileVisibilityConverter}}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Clear existing data first" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ClearExistingData}"/>
                                    </Grid>
                                    <TextBlock Text="On: deletes everything already on the drive so the test can use nearly its full capacity. Off: only writes into current free space and leaves your files alone — but then the test can only ever confirm as much capacity as is currently free, and can't check space your existing files occupy."
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <TextBlock Text="When to remove test files" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <StackPanel>
                                        <RadioButton Content="Immediately after the test" GroupName="Cleanup" Margin="0,0,0,4"
                                                     IsChecked="{Binding CleanupPolicy, Converter={StaticResource CleanupDeleteAfterTestConverter}}"/>
                                        <RadioButton Content="When the app closes (so you can inspect them first)" GroupName="Cleanup" Margin="0,0,0,4"
                                                     IsChecked="{Binding CleanupPolicy, Converter={StaticResource CleanupDeleteOnAppCloseConverter}}"/>
                                        <RadioButton Content="Never automatically — I'll clean up manually" GroupName="Cleanup" Margin="0,0,0,8"
                                                     IsChecked="{Binding CleanupPolicy, Converter={StaticResource CleanupKeepUntilManualConverter}}"/>
                                    </StackPanel>
                                    <ui:Button Content="Clean Up Test Files Now" Command="{Binding CleanUpTestFilesNowCommand}"
                                               HorizontalAlignment="Left" Padding="8,4">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Delete24"/>
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Header="Capacity Test" IsExpanded="True" Margin="0,0,0,12">
                            <ui:CardExpander.Icon>
                                <ui:SymbolIcon Symbol="ClipboardTaskListLtr24"/>
                            </ui:CardExpander.Icon>
                            <StackPanel Margin="0,8,0,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Run capacity test" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding RunCapacityTest}"/>
                                </Grid>
                                <TextBlock Text="Writes and reads back unique data across the claimed capacity to prove every address is real, writable storage — this is what catches fake-capacity drives."
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="Scan Depth" FontWeight="SemiBold" Margin="0,0,0,8"
                                           IsEnabled="{Binding RunCapacityTest}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <StackPanel IsEnabled="{Binding RunCapacityTest}">
                                    <RadioButton Content="Quick — a few hundred sampled blocks, fast" GroupName="ScanDepth" Margin="0,0,0,4"
                                                 IsChecked="{Binding CapacityScanDepth, Converter={StaticResource ScanDepthQuickConverter}}"/>
                                    <RadioButton Content="Standard — ~5% of blocks, evenly spread" GroupName="ScanDepth" Margin="0,0,0,4"
                                                 IsChecked="{Binding CapacityScanDepth, Converter={StaticResource ScanDepthStandardConverter}}"/>
                                    <RadioButton Content="Full — every single block, slow but exhaustive" GroupName="ScanDepth"
                                                 IsChecked="{Binding CapacityScanDepth, Converter={StaticResource ScanDepthFullConverter}}"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Header="Speed Test" IsExpanded="True" Margin="0,0,0,20">
                            <ui:CardExpander.Icon>
                                <ui:SymbolIcon Symbol="TopSpeed24"/>
                            </ui:CardExpander.Icon>
                            <StackPanel Margin="0,8,0,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Run speed test" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding RunSpeedTest}"/>
                                </Grid>
                                <TextBlock Text="Each of the 3 slots below tests a real-world file-size category, with randomized file sizes across its range rather than one repeated size — pick which 3 to run."
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <StackPanel IsEnabled="{Binding RunSpeedTest}">
                                    <!-- Slot 1 -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding SpeedTestSlot1Enabled}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding SpeedTestCategoryOptions}"
                                                  SelectedValue="{Binding SpeedTestSlot1Category}" SelectedValuePath="Category" DisplayMemberPath="DisplayName"
                                                  IsEnabled="{Binding SpeedTestSlot1Enabled}"/>
                                    </Grid>
                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="34,0,0,12">
                                        <Run Text="{Binding SpeedTestSlot1Info.WorkloadDescription, Mode=OneWay}"/>
                                        <Run Text=" — file size " /><Run Text="{Binding SpeedTestSlot1Info.SizeRangeText, Mode=OneWay}"/>
                                    </TextBlock>

                                    <!-- Slot 2 -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding SpeedTestSlot2Enabled}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding SpeedTestCategoryOptions}"
                                                  SelectedValue="{Binding SpeedTestSlot2Category}" SelectedValuePath="Category" DisplayMemberPath="DisplayName"
                                                  IsEnabled="{Binding SpeedTestSlot2Enabled}"/>
                                    </Grid>
                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="34,0,0,12">
                                        <Run Text="{Binding SpeedTestSlot2Info.WorkloadDescription, Mode=OneWay}"/>
                                        <Run Text=" — file size " /><Run Text="{Binding SpeedTestSlot2Info.SizeRangeText, Mode=OneWay}"/>
                                    </TextBlock>

                                    <!-- Slot 3 -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding SpeedTestSlot3Enabled}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding SpeedTestCategoryOptions}"
                                                  SelectedValue="{Binding SpeedTestSlot3Category}" SelectedValuePath="Category" DisplayMemberPath="DisplayName"
                                                  IsEnabled="{Binding SpeedTestSlot3Enabled}"/>
                                    </Grid>
                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="34,0,0,0">
                                        <Run Text="{Binding SpeedTestSlot3Info.WorkloadDescription, Mode=OneWay}"/>
                                        <Run Text=" — file size " /><Run Text="{Binding SpeedTestSlot3Info.SizeRangeText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <TextBlock Text="Head to the Run Test tab to start and watch progress." FontStyle="Italic"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" FontSize="17" Margin="0,0,8,0" Foreground="#00A6FB"/>
                        <TextBlock Text="Run Test" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Background="#1A00A6FB" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                                    <ui:SymbolIcon Symbol="Play24" Foreground="#00A6FB" FontSize="20"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Run Test" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Start the test and watch progress live." FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:Button Content="Start Test" Command="{Binding StartTestCommand}" Appearance="Primary"
                                               IsEnabled="{Binding IsTestRunning, Converter={StaticResource InverseBoolConverter}}"
                                               Margin="0,0,8,0" Padding="20,10" FontSize="15">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Play24"/>
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Content="Cancel" Command="{Binding CancelTestCommand}"
                                               IsEnabled="{Binding IsTestRunning}" Padding="20,10" FontSize="15" Margin="0,0,8,0"/>
                                    <ui:Button Content="Run Next Test" Command="{Binding RunNextTestCommand}" Appearance="Primary"
                                               Visibility="{Binding IsWaitingForNextTest, Converter={StaticResource BoolToVisibility}}"
                                               Padding="20,10" FontSize="15" Margin="0,0,16,0">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Play24"/>
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ui:ToggleSwitch IsChecked="{Binding AutoAdvanceTests}"
                                                      OnContent="Auto-Advance" OffContent="Auto-Advance"
                                                      VerticalAlignment="Center"
                                                      ToolTip="On: tests run straight through. Off: the run pauses after each test until you click &quot;Run Next Test&quot;."/>
                                </StackPanel>
                                <TextBlock Text="{Binding ProgressText}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Row="2" Background="#1A00A6FB" BorderBrush="#00A6FB" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10" Margin="0,0,0,16"
                                    Visibility="{Binding IsWaitingForNextTest, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Play24" Foreground="#00A6FB" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Test complete — click &quot;Run Next Test&quot; when you're ready to continue."
                                               FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Every card at full size and width — whichever test is currently
                                 running simply sorts to the top, so nothing ever shrinks down to
                                 where its trend lines don't fit. -->
                            <ItemsControl Grid.Row="3" ItemsSource="{Binding AllTracks}"
                                          ItemTemplateSelector="{StaticResource TrackTemplateSelector}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="0,0,0,12"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <ProgressBar VerticalAlignment="Top" Height="4" Minimum="0" Maximum="1"
                                 Value="{Binding ProgressFraction, Mode=OneWay}"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border x:Name="FakeBlockFlashOverlay" Background="#E74C3C" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
